<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SOC Portfolio Audit Report</title>
  {% include "_styles.html.j2" %}
</head>
<body class="audit">
  <main>
    <header class="hero">
      <div>
        <div class="eyebrow">SOC Advisor Prototype / Audit Copy</div>
        <h1>{{ report.profile.profile_label }} decision trace</h1>
        <p>{{ report.prose.executive_summary }}</p>
      </div>
      <div class="hero-side">
        <div class="hero-metric">
          <span>Portfolio value</span>
          <strong>{{ report.portfolio_value_label or "Not captured" }}</strong>
        </div>
        <div class="hero-metric">
          <span>Session</span>
          <strong>{{ report.session_id }}</strong>
        </div>
        <div class="hero-metric">
          <span>Generated</span>
          <strong>{{ report.generated_at_label }}</strong>
        </div>
      </div>
    </header>

    <section>
      <div class="eyebrow">User-Facing Summary</div>
      <h2>Same portfolio facts the client report sees.</h2>
      <div class="metric-grid">
        {% for metric in report.metrics %}
        <div class="metric">
          <span>{{ metric.label }}</span>
          <strong>{{ metric.value }}</strong>
          {% if metric.amount %}
          <div class="money">{{ metric.amount }} based on {{ report.portfolio_value_label }}</div>
          {% endif %}
          <p>{{ metric.note }}</p>
        </div>
        {% endfor %}
      </div>
    </section>

    <section>
      <div class="eyebrow">Technical Risk Signals</div>
      <h2>Sensitivity values kept for audit and debugging.</h2>
      <div class="metric-grid">
        {% for metric in report.sensitivity_metrics %}
        <div class="metric">
          <span>{{ metric.label }}</span>
          <strong>{{ metric.value }}</strong>
          <p>{{ metric.note }}</p>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="summary">
      <div>
        <div class="eyebrow">Superclass Mix</div>
        <h2>Allocation grouped by broad asset bucket.</h2>
      </div>
      <div class="panel">
        <div class="stack" aria-label="Portfolio superclass allocation">
          {% for allocation in report.class_allocations %}
          <div
            class="segment class-{{ allocation.slug }}"
            title="{{ allocation.label }} {{ allocation.weight_label }}"
            style="width: {{ allocation.bar_width }}%">
          </div>
          {% endfor %}
        </div>
        <div class="legend">
          {% for allocation in report.class_allocations %}
          <div class="legend-item">
            <span>{{ allocation.label }}</span>
            <span class="legend-values">
              <strong>{{ allocation.weight_label }}</strong>
              {% if allocation.amount_label %}
              <span class="money">{{ allocation.amount_label }}</span>
              {% endif %}
            </span>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section>
      <div class="eyebrow">Full Holdings</div>
      <h2>Every holding selected by the optimizer.</h2>
      <table>
        <thead>
          <tr>
            <th>Ticker</th>
            <th>Superclass</th>
            <th>Asset class</th>
            <th>Currency</th>
            <th>Weight</th>
            <th>Est. allocation</th>
            <th>Est. return</th>
            <th>Income yield</th>
            <th>Volatility</th>
          </tr>
        </thead>
        <tbody>
          {% for holding in report.all_holdings %}
          <tr>
            <td>{{ holding.ticker }}</td>
            <td>{{ holding.super_class }}</td>
            <td>{{ holding.asset_class }}</td>
            <td>{{ holding.currency }}</td>
            <td class="numeric">{{ holding.weight_label }}</td>
            <td class="numeric">{{ holding.amount_label or "N/A" }}</td>
            <td class="numeric">{{ holding.expected_return_label }}</td>
            <td class="numeric">{{ holding.income_yield_label }}</td>
            <td class="numeric">{{ holding.volatility_label }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <div class="eyebrow">Decision Trace</div>
      <h2>What produced this result.</h2>
      <table>
        <tbody>
          {% for row in report.trace_rows %}
          <tr>
            <th>{{ row.label }}</th>
            <td>{{ row.value }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    {% if report.calculation_trail %}
    <section>
      <div class="eyebrow">Chronological Calculation Trail</div>
      <h2>Formula path from answers to portfolio.</h2>
      <div class="summary">
        {% for step in report.calculation_trail %}
        <div class="panel">
          <h3>{{ step.title }}</h3>
          <table>
            <tbody>
              <tr>
                <th>Formula</th>
                <td>{{ step.formula }}</td>
              </tr>
              <tr>
                <th>Values</th>
                <td>{{ step["values"] }}</td>
              </tr>
              <tr>
                <th>Result</th>
                <td>{{ step.result }}</td>
              </tr>
            </tbody>
          </table>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if report.scoring_policy_trace %}
    <section>
      <div class="eyebrow">Questionnaire Scoring</div>
      <h2>DOCX-aligned risk bucket calculation.</h2>
      <table>
        <tbody>
          <tr>
            <th>Method</th>
            <td>{{ report.scoring_policy_trace.method }}</td>
          </tr>
          <tr>
            <th>Capacity score</th>
            <td>{{ report.scoring_policy_trace.capacity_score }}</td>
          </tr>
          <tr>
            <th>Tolerance score</th>
            <td>{{ report.scoring_policy_trace.tolerance_score }}</td>
          </tr>
          <tr>
            <th>Final score before caps</th>
            <td>{{ report.scoring_policy_trace.final_score_before_caps }}</td>
          </tr>
          <tr>
            <th>Final score after caps</th>
            <td>{{ report.scoring_policy_trace.final_score_after_caps }}</td>
          </tr>
          <tr>
            <th>Displayed risk score</th>
            <td>{{ report.scoring_policy_trace.displayed_risk_score }}</td>
          </tr>
          <tr>
            <th>Draft profile from score</th>
            <td>{{ report.scoring_policy_trace.draft_profile }}</td>
          </tr>
          <tr>
            <th>Final scoring profile</th>
            <td>{{ report.scoring_policy_trace.final_profile }}</td>
          </tr>
          <tr>
            <th>Applied caps</th>
            <td>{{ report.scoring_policy_trace.applied_caps|join("; ") or "None" }}</td>
          </tr>
          <tr>
            <th>Manual override used</th>
            <td>{{ report.scoring_policy_trace.manual_override_used }}</td>
          </tr>
          <tr>
            <th>Manual override</th>
            <td>{{ report.scoring_policy_trace.manual_override }}</td>
          </tr>
        </tbody>
      </table>
      <div class="summary">
        <div class="panel">
          <h3>Section scores</h3>
          <ul class="note-list">
            {% for label, value in report.scoring_policy_trace.section_scores.items() %}
            <li>{{ label }}: {{ value }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="panel">
          <h3>Question scores</h3>
          <ul class="note-list">
            {% for label, value in report.scoring_policy_trace.question_scores.items() %}
            <li>{{ label }}: {{ value }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
    {% endif %}

    {% if report.risk_reality_check %}
    <section>
      <div class="eyebrow">Risk Reality Check</div>
      <h2>Pre-report volatility stress illustration.</h2>
      <table>
        <tbody>
          <tr>
            <th>Method</th>
            <td>{{ report.risk_reality_check.method }}</td>
          </tr>
          <tr>
            <th>Multiplier</th>
            <td>{{ report.risk_reality_check.multiplier }}</td>
          </tr>
          <tr>
            <th>Annual volatility used</th>
            <td>{{ report.risk_reality_check.annual_volatility }}</td>
          </tr>
          <tr>
            <th>Stress movement shown</th>
            <td>{{ report.risk_reality_check.stress_percent }}</td>
          </tr>
          <tr>
            <th>Portfolio value</th>
            <td>{{ report.risk_reality_check.portfolio_value or "Not captured" }}</td>
          </tr>
          <tr>
            <th>Stress amount shown</th>
            <td>{{ report.risk_reality_check.stress_amount or "N/A" }}</td>
          </tr>
          <tr>
            <th>User action</th>
            <td>{{ report.risk_reality_check.user_action }}</td>
          </tr>
          <tr>
            <th>Revised question ids</th>
            <td>{{ report.risk_reality_check.revised_question_ids|join(", ") or "None" }}</td>
          </tr>
        </tbody>
      </table>
      <p class="panel-subtle">
        This is a simplified stress estimate, not formal VaR and not a promise about losses.
      </p>
    </section>
    {% endif %}

    {% if report.liquidity_policy_check %}
    <section>
      <div class="eyebrow">Liquidity Policy Check</div>
      <h2>Cash-floor compatibility before optimization.</h2>
      <table>
        <tbody>
          <tr>
            <th>Method</th>
            <td>{{ report.liquidity_policy_check.method }}</td>
          </tr>
          <tr>
            <th>Liquidity bucket</th>
            <td>{{ report.liquidity_policy_check.liquidity_bucket }}</td>
          </tr>
          <tr>
            <th>Formula</th>
            <td>major expense + monthly expenses * emergency months</td>
          </tr>
          <tr>
            <th>Portfolio value</th>
            <td>{{ report.liquidity_policy_check.portfolio_value }}</td>
          </tr>
          <tr>
            <th>Major expense amount</th>
            <td>{{ report.liquidity_policy_check.major_expense_withdrawal_amount }}</td>
          </tr>
          <tr>
            <th>Monthly expenses</th>
            <td>{{ report.liquidity_policy_check.essential_monthly_expenses }}</td>
          </tr>
          <tr>
            <th>Emergency answer</th>
            <td>{{ report.liquidity_policy_check.emergency_fund_option_id }}</td>
          </tr>
          <tr>
            <th>Emergency months used</th>
            <td>{{ report.liquidity_policy_check.emergency_months_used }}</td>
          </tr>
          <tr>
            <th>Required liquidity</th>
            <td>{{ report.liquidity_policy_check.required_liquidity_amount }}</td>
          </tr>
          <tr>
            <th>Liquidity floor</th>
            <td>{{ report.liquidity_policy_check.liquidity_floor }}</td>
          </tr>
          <tr>
            <th>Selected profile</th>
            <td>{{ report.liquidity_policy_check.selected_profile }}</td>
          </tr>
          <tr>
            <th>Selected Cash ceiling</th>
            <td>{{ report.liquidity_policy_check.selected_cash_ceiling }}</td>
          </tr>
          <tr>
            <th>Selected profile compatible</th>
            <td>{{ report.liquidity_policy_check.selected_profile_compatible }}</td>
          </tr>
          <tr>
            <th>Effective profile</th>
            <td>{{ report.liquidity_policy_check.effective_profile }}</td>
          </tr>
          <tr>
            <th>Effective Cash ceiling</th>
            <td>{{ report.liquidity_policy_check.effective_cash_ceiling }}</td>
          </tr>
          <tr>
            <th>Profile adjusted</th>
            <td>{{ report.liquidity_policy_check.profile_adjusted }}</td>
          </tr>
          <tr>
            <th>User action</th>
            <td>{{ report.liquidity_policy_check.user_action }}</td>
          </tr>
        </tbody>
      </table>
    </section>
    {% endif %}

    <section>
      <div class="eyebrow">Captured Answers</div>
      <h2>Questionnaire inputs saved for this run.</h2>
      <table>
        <thead>
          <tr>
            <th>Question</th>
            <th>Answer</th>
            <th>Type</th>
            <th>Used for scoring</th>
            <th>Used directly in allocation</th>
          </tr>
        </thead>
        <tbody>
          {% for answer in report.decision_trace.captured_answers %}
          <tr>
            <td>{{ answer.question_text }}</td>
            <td>{{ answer.answer_label }}</td>
            <td>{{ answer.answer_type }}</td>
            <td>{{ "yes" if answer.used_for_scoring else "no" }}</td>
            <td>{{ "yes" if answer.used_for_allocation else "no" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <div class="eyebrow">Constraints</div>
      <h2>Profile policy applied before solving.</h2>
      <div class="summary">
        <div class="panel">
          <h3>Superclass minima</h3>
          <ul class="note-list">
            {% for label, value in report.decision_trace.super_class_minima.items() %}
            <li>{{ label }}: {{ "%.1f"|format(value * 100) }}%</li>
            {% endfor %}
          </ul>
        </div>
        <div class="panel">
          <h3>Superclass maxima</h3>
          <ul class="note-list">
            {% for label, value in report.decision_trace.super_class_maxima.items() %}
            <li>{{ label }}: {{ "%.1f"|format(value * 100) }}%</li>
            {% endfor %}
          </ul>
        </div>
        <div class="panel">
          <h3>Applied overlays</h3>
          <ul class="note-list">
            {% if report.decision_trace.applied_overlays %}
            {% for overlay in report.decision_trace.applied_overlays %}
            <li>{{ overlay }}</li>
            {% endfor %}
            {% else %}
            <li>None</li>
            {% endif %}
          </ul>
        </div>
      </div>
    </section>

    <section>
      <div class="eyebrow">Raw Trace JSON</div>
      <h2>Machine-readable audit payload.</h2>
      <pre>{{ report.trace_json }}</pre>
    </section>
  </main>
</body>
</html>
