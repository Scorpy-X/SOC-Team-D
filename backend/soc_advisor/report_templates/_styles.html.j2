<style>
  :root {
    --ink: #15253a;
    --muted: #5f7088;
    --paper: #f3f8fc;
    --panel: rgba(255, 255, 255, 0.76);
    --line: #d5e0ee;
    --accent: #4d9ae0;
    --accent-strong: #3278c2;
    --cash: #8ca96b;
    --fixed-income: #4d7ba8;
    --equity: #4b90d8;
    --fund: #75a9db;
    --other: #8c91a8;
    --body-font: "Aptos", "Segoe UI Variable Text", "Segoe UI", sans-serif;
    --heading-font: "Aptos Display", "Segoe UI Variable Display", "Bahnschrift", "Aptos", sans-serif;
    --number-font: "Cascadia Mono", "Consolas", "Segoe UI Mono", monospace;
    --panel-shadow: 0 20px 46px rgba(28, 58, 92, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    color: var(--ink);
    background:
      radial-gradient(circle at 10% 4%, rgba(95, 166, 224, 0.16), transparent 28rem),
      radial-gradient(circle at 88% 0%, rgba(150, 203, 241, 0.14), transparent 20rem),
      linear-gradient(140deg, #f7fbff 0%, #edf5fb 48%, #f3f8fc 100%);
    font-family: var(--body-font);
    line-height: 1.5;
  }

  main {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 40px 0 64px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 36px;
    min-height: 320px;
    align-items: end;
    padding: 48px;
    border: 1px solid rgba(197, 220, 241, 0.3);
    background:
      radial-gradient(circle at top right, rgba(112, 183, 235, 0.18), transparent 15rem),
      linear-gradient(115deg, rgba(16, 34, 56, 0.96), rgba(31, 60, 92, 0.84)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 48px);
    color: #f4fbff;
    border-radius: 32px;
    box-shadow: 0 26px 70px rgba(16, 34, 56, 0.2);
  }

  .eyebrow {
    color: #c6e1f8;
    font: 700 0.74rem/1.2 var(--body-font);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1, h2, h3 {
    font-family: var(--heading-font);
    line-height: 1.05;
    margin: 0;
  }

  h1 {
    max-width: 760px;
    margin-top: 18px;
    font-size: clamp(2.35rem, 5vw, 4.8rem);
    font-weight: 650;
    letter-spacing: -0.055em;
  }

  h2 {
    max-width: 760px;
    font-size: clamp(1.55rem, 3vw, 2.7rem);
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  h3 {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .hero p, .summary p {
    max-width: 72ch;
    color: inherit;
    font-size: 1rem;
  }

  .hero-side {
    border-left: 1px solid rgba(248, 244, 255, 0.18);
    padding-left: 28px;
  }

  .hero-metric {
    margin-top: 18px;
  }

  .hero-metric span, .metric span {
    display: block;
    color: var(--muted);
    font: 700 0.68rem/1.2 var(--body-font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-metric strong {
    display: block;
    color: #f4fbff;
    font-family: var(--heading-font);
    font-size: 1.45rem;
    font-weight: 650;
  }

  section {
    margin-top: 44px;
  }

  .summary {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 32px;
    align-items: start;
  }

  .panel {
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--panel);
    box-shadow: var(--panel-shadow);
    backdrop-filter: blur(10px);
  }

  .panel-subtle {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .stack {
    display: flex;
    height: 44px;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid rgba(77, 154, 224, 0.16);
    background: #dfedf8;
  }

  .segment {
    min-width: 2px;
  }

  .class-cash { background: var(--cash); }
  .class-fixed-income { background: var(--fixed-income); }
  .class-equity { background: var(--equity); }
  .class-fund { background: var(--fund); }
  .class-other { background: var(--other); }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .legend-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }

  .legend-values {
    display: grid;
    justify-items: end;
    gap: 2px;
  }

  .legend-values strong,
  .money,
  .metric strong,
  td.numeric {
    font-family: var(--number-font);
    font-variant-numeric: tabular-nums;
  }

  .money {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .metric {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .metric strong {
    display: block;
    margin: 8px 0;
    font-size: 1.65rem;
    font-weight: 650;
  }

  .holdings-group {
    display: grid;
    grid-template-columns: minmax(150px, 220px) 1fr;
    gap: 28px;
    padding: 30px 0;
    border-top: 1px solid var(--line);
  }

  .holding-row {
    display: grid;
    grid-template-columns: minmax(86px, 0.55fr) minmax(220px, 1.45fr) minmax(86px, 0.45fr) minmax(116px, 0.55fr);
    gap: 18px;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid rgba(213, 224, 238, 0.82);
  }

  .holding-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .asset-code-pill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border: 1px solid rgba(77, 154, 224, 0.18);
    border-radius: 999px;
    padding: 5px 10px;
    background: rgba(77, 154, 224, 0.08);
    font-family: var(--number-font);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .holding-detail {
    min-width: 0;
  }

  .holding-detail strong {
    display: block;
    overflow-wrap: anywhere;
  }

  .holding-detail span {
    display: block;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .holding-value {
    justify-self: end;
    text-align: right;
  }

  .mini-bar {
    height: 10px;
    border-radius: 999px;
    background: #dfedf8;
    overflow: hidden;
  }

  .mini-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--body-font);
    font-size: 0.84rem;
  }

  th, td {
    padding: 12px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  th {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td.numeric {
    text-align: right;
    white-space: nowrap;
  }

  .note-list {
    padding-left: 1rem;
  }

  .audit {
    background: #132235;
    color: #f4fbff;
  }

  .audit .panel,
  .audit table,
  .audit th,
  .audit td {
    border-color: rgba(247, 237, 219, 0.22);
  }

  pre {
    overflow: auto;
    padding: 20px;
    border-radius: 18px;
    background: rgba(12, 28, 46, 0.36);
    color: #f4fbff;
  }

  @media (max-width: 760px) {
    main {
      width: min(100% - 20px, 1120px);
      padding-top: 10px;
    }

    .hero,
    .summary,
    .holdings-group {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 28px;
      border-radius: 24px;
    }

    .hero-side {
      border-left: 0;
      border-top: 1px solid rgba(255, 248, 232, 0.22);
      padding-left: 0;
      padding-top: 20px;
    }

    .holding-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .holding-value {
      justify-self: start;
      text-align: left;
    }
  }
</style>
