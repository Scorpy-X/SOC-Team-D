# Copy this file to `.env` and add your local secrets there.
# Do not commit real API keys to this file.

# SOC live data access
DIMENSION_DEPTHS_API_KEY=
DIMENSION_DEPTHS_BASE_URL=https://dimension-depths-v2-production.up.railway.app
PORTFOLIO_DATA_MODE=csv_only
SOC_API_TIMEOUT_SECONDS=3

# Optional OpenAI-assisted report wording
# Leave ADVISOR_REPORT_USE_LLM=false to use deterministic report text only.
OPENAI_API_KEY=
ADVISOR_REPORT_USE_LLM=false
ADVISOR_REPORT_LLM_MODEL=gpt-5.4-mini
ADVISOR_REPORT_LLM_TIMEOUT_SECONDS=20
ADVISOR_REPORT_LLM_TEMPERATURE=0.2

# Local generated HTML reports
ADVISOR_REPORTS_DIR=data/reports
